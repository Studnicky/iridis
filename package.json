{
  "name": "@studnicky/iridis-workspace",
  "packageManager": "pnpm@10.32.1",
  "private": true,
  "type": "module",
  "pnpm": {
    "overrides": {
      "@cosmos.gl/graph": "3.3.0",
      "@changesets/parse>js-yaml": "4.3.2",
      "@studnicky/json-tology": "0.27.1",
      "brace-expansion": ">=5.0.9",
      "dompurify": "3.4.17",
      "eyereasoner>@rdfjs/types": "^1.1.0",
      "postcss": ">=8.5.18",
      "read-yaml-file>js-yaml": "3.15.2",
      "semver": "7.8.5",
      "fast-uri": "3.1.9",
      "fontless>esbuild": "0.28.1",
      "katex": "0.18.2",
      "serialize-javascript": "7.1.3",
      "launch-editor": ">=2.14.2",
      "@apidevtools/json-schema-ref-parser>js-yaml": "4.3.2",
      "shell-quote": "1.11.0",
      "@studnicky/fetch>undici": "8.12.2",
      "@digitalbazaar/http-client>undici": "6.29.1",
      "nuxt>undici": "8.12.2",
      "@nuxt/devtools": "3.4.3",
      "zod": "4.6.7"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "fsevents",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "scripts": {
    "prepare": "bash scripts/install-hooks.sh",
    "setup-hooks": "bash scripts/install-hooks.sh",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "pnpm -r run test --if-present && pnpm run test:analytic-certificates && pnpm run test:architecture",
    "test:analytic-certificates": "TSX_TSCONFIG_PATH=tsconfig.json node --import tsx packages/contrast/scripts/VerifyAnalyticCertificates.ts && pnpm --filter @studnicky/iridis run verify:hue-resolution-chroma",
    "test:architecture": "node --test scripts/architecture-boundary.test.mjs",
    "build": "tsc --build --force tsconfig.build.json",
    "packages:stage": "node scripts/package-consumer-smoke.mjs --stage",
    "packages:pack:dry": "pnpm -r run pack:dry --if-present",
    "packages:pipeline:test": "node --test scripts/package-pipeline.test.mjs",
    "packages:publish:test": "node --test scripts/package-publish.test.mjs",
    "packages:consumer:test": "node --test scripts/package-consumer-smoke.test.mjs",
    "packages:consumer:smoke": "node scripts/package-consumer-smoke.mjs",
    "packages:verify": "pnpm run build && pnpm run packages:pipeline:test && pnpm run packages:publish:test && pnpm run packages:consumer:test && pnpm run packages:consumer:smoke",
    "site:debug": "pnpm --filter site run dev -- --host 127.0.0.1 --port 3000 --strictPort --open",
    "clean": "find packages -name dist -type d -exec rm -rf {} + ; rm -f packages/*/tsconfig.tsbuildinfo",
    "stamp-version": "node scripts/stamp-version.mjs",
    "stamp-version:check": "node scripts/stamp-version.mjs --check",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@primeuix/themes": "^2.0.3",
    "@studnicky/eslint-config": "^15.2.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "commander": "13.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "lint-staged": "^16.1.0",
    "primevue": "^4.5.5",
    "semver": "7.8.5",
    "tar": "^7.5.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "validate-npm-package-name": "8.0.0",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=11.0.0"
  },
  "iridis": {
    "seo": {
      "googleSiteVerification": "",
      "bingSiteVerification": "",
      "twitterHandle": ""
    }
  },
  "dependencies": {
    "@studnicky/batch": "^14.0.0",
    "@studnicky/cache": "^15.2.1",
    "@studnicky/circular-buffer": "^15.2.1",
    "@studnicky/clock": "^15.2.1",
    "@studnicky/concurrency": "^15.2.1",
    "@studnicky/config": "^15.2.1",
    "@studnicky/context": "^15.2.1",
    "@studnicky/errors": "^15.2.1",
    "@studnicky/event-bus": "^15.2.1",
    "@studnicky/fetch": "^15.2.1",
    "@studnicky/file-lock": "^14.0.0",
    "@studnicky/fsm": "^15.2.1",
    "@studnicky/json": "^15.2.1",
    "@studnicky/logger": "^15.2.1",
    "@studnicky/mutex": "^14.0.0",
    "@studnicky/pipeline": "^15.2.1",
    "@studnicky/predicates": "^9.2.0",
    "@studnicky/resilience": "^15.2.1",
    "@studnicky/retry": "^14.0.0",
    "@studnicky/sample-buffer": "^14.0.0",
    "@studnicky/scheduler": "^15.2.1",
    "@studnicky/signal": "^15.2.1",
    "@studnicky/system": "^15.2.1",
    "@studnicky/throttle": "^14.0.0",
    "@studnicky/timing": "^14.0.0",
    "@studnicky/types": "^15.2.1",
    "@studnicky/virtual-fs": "^15.2.1"
  },
  "version": "0.14.1"
}
