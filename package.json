{
  "name": "@studnicky/iridis-workspace",
  "packageManager": "pnpm@10.32.1",
  "private": true,
  "type": "module",
  "pnpm": {
    "overrides": {
      "@cosmos.gl/graph": "3.3.0",
      "@studnicky/json-tology": "0.27.0",
      "eyereasoner>@rdfjs/types": "^1.1.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "fsevents",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "pnpm -r run test --if-present && pnpm run test:architecture",
    "test:architecture": "node --test scripts/architecture-boundary.test.mjs",
    "build": "tsc --build --force tsconfig.build.json",
    "packages:stage": "node scripts/package-consumer-smoke.mjs --stage",
    "packages:pack:dry": "pnpm -r run pack:dry --if-present",
    "packages:pipeline:test": "node --test scripts/package-pipeline.test.mjs",
    "packages:publish:test": "node --test scripts/package-publish.test.mjs",
    "packages:consumer:test": "node --test scripts/package-consumer-smoke.test.mjs",
    "packages:consumer:smoke": "node scripts/package-consumer-smoke.mjs",
    "packages:verify": "pnpm run build && pnpm run packages:pipeline:test && pnpm run packages:publish:test && pnpm run packages:consumer:test && pnpm run packages:consumer:smoke",
    "site:debug": "pnpm --filter site run dev -- --host 127.0.0.1 --port 3000 --strictPort --open",
    "clean": "find packages -name dist -type d -exec rm -rf {} + ; rm -f packages/*/tsconfig.tsbuildinfo",
    "stamp-version": "node scripts/stamp-version.mjs",
    "stamp-version:check": "node scripts/stamp-version.mjs --check",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@primeuix/themes": "^2.0.3",
    "@studnicky/eslint-config": "^7.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "commander": "13.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "lint-staged": "^16.1.0",
    "primevue": "^4.5.5",
    "semver": "7.8.5",
    "tar": "^7.5.19",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "validate-npm-package-name": "6.0.2",
    "vue": "^3.5.34",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "iridis": {
    "seo": {
      "googleSiteVerification": "",
      "bingSiteVerification": "",
      "twitterHandle": ""
    }
  },
  "dependencies": {
    "@studnicky/batch": "^4.0.0",
    "@studnicky/cache": "^4.0.0",
    "@studnicky/circular-buffer": "^4.0.0",
    "@studnicky/clock": "^4.0.0",
    "@studnicky/concurrency": "^4.0.0",
    "@studnicky/config": "^4.0.0",
    "@studnicky/context": "^4.0.0",
    "@studnicky/errors": "^4.0.0",
    "@studnicky/event-bus": "^4.0.0",
    "@studnicky/fetch": "^4.0.0",
    "@studnicky/file-lock": "^4.0.0",
    "@studnicky/fsm": "^4.0.0",
    "@studnicky/json": "^4.0.0",
    "@studnicky/logger": "^4.0.0",
    "@studnicky/mutex": "^4.0.0",
    "@studnicky/pipeline": "^4.0.0",
    "@studnicky/predicates": "^4.0.0",
    "@studnicky/resilience": "^4.0.0",
    "@studnicky/retry": "^4.0.0",
    "@studnicky/sample-buffer": "^4.0.0",
    "@studnicky/scheduler": "^4.0.0",
    "@studnicky/signal": "^4.0.0",
    "@studnicky/system": "^4.0.0",
    "@studnicky/throttle": "^4.0.0",
    "@studnicky/timing": "^4.0.0",
    "@studnicky/types": "^4.0.0",
    "@studnicky/virtual-fs": "^4.0.0"
  },
  "version": "0.11.0"
}
