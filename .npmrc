# Route @studnicky scope to GitHub Packages registry.
# Auth token is injected at runtime via NODE_AUTH_TOKEN (actions/setup-node) —
# never committed here.
@studnicky:registry=https://npm.pkg.github.com

# Refuse to resolve package versions published less than 7 days ago,
# guarding against just-published malicious or unstable releases.
min-release-age = 7
