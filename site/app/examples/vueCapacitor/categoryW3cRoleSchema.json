{
  "name": "category-w3c",
  "description": "WCAG 2.1 AAA-strength role schema for category colour palettes",
  "roles": [
    {
      "name": "canvas",
      "description": "Page / card background",
      "intent": "background",
      "required": true,
      "lightnessRange": [
        0.92,
        1
      ]
    },
    {
      "name": "surface",
      "description": "Elevated surface (modal, sheet)",
      "intent": "background",
      "required": true,
      "lightnessRange": [
        0.86,
        0.96
      ]
    },
    {
      "name": "accent",
      "description": "Primary interactive / brand colour",
      "intent": "accent",
      "required": true,
      "lightnessRange": [
        0.35,
        0.46
      ],
      "chromaRange": [
        0.1,
        0.12
      ]
    },
    {
      "name": "onAccent",
      "description": "Text / icons placed on accent",
      "intent": "onAccent",
      "required": true,
      "lightnessRange": [
        0.98,
        1
      ]
    },
    {
      "name": "border",
      "description": "Dividers and focus rings",
      "lightnessRange": [
        0.6,
        0.8
      ]
    },
    {
      "name": "muted",
      "description": "Secondary / de-emphasised text",
      "intent": "muted",
      "lightnessRange": [
        0.45,
        0.65
      ]
    },
    {
      "name": "text",
      "description": "Primary body text",
      "intent": "text",
      "required": true,
      "lightnessRange": [
        0.1,
        0.23
      ],
      "chromaRange": [
        0.08,
        0.09
      ]
    }
  ],
  "contrastPairs": [
    {
      "contrastClass": "text",
      "foreground": "text",
      "background": "canvas",
      "minimumContrastRatio": 7,
      "algorithm": "wcag21"
    },
    {
      "contrastClass": "text",
      "foreground": "text",
      "background": "surface",
      "minimumContrastRatio": 7,
      "algorithm": "wcag21"
    },
    {
      "contrastClass": "text",
      "foreground": "onAccent",
      "background": "accent",
      "minimumContrastRatio": 7,
      "algorithm": "wcag21"
    },
    {
      "contrastClass": "non-text",
      "foreground": "border",
      "background": "canvas",
      "minimumContrastRatio": 3,
      "algorithm": "wcag21"
    }
  ],
  "relationshipGraph": {
    "groups": [
      {
        "anchor": "accent",
        "defaultMode": "default",
        "id": "accent-content",
        "modes": [
          {
            "hueOffsets": [
              {
                "degrees": 0,
                "variantId": "default"
              }
            ],
            "id": "default"
          }
        ],
        "name": "Accent content",
        "relationships": [
          {
            "id": "accent-to-onAccent",
            "operation": "alias",
            "priority": 0,
            "relaxability": "fixed",
            "source": "accent",
            "target": "onAccent"
          }
        ]
      }
    ]
  }
}
