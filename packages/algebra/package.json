{
  "name": "@studnicky/iridis-algebra",
  "description": "Pure vector-math operations over palettes treated as points in OKLCH×N space — lerp, subtract, nearest, drift, perpendicular.",
  "version": "0.13.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json",
    "prepare:publish": "node ../../scripts/package-pipeline.mjs algebra",
    "build:package": "pnpm run build && pnpm run prepare:publish",
    "pack:dry": "pnpm run build:package && npm pack --dry-run ./.publish",
    "publish:dry": "pnpm run build:package && npm publish --dry-run ./.publish",
    "typecheck": "tsc --noEmit",
    "test": "TSX_TSCONFIG_PATH=../../tsconfig.json node --import tsx --test 'tests/**/*.test.ts'",
    "clean": "rm -rf .publish dist"
  },
  "dependencies": {
    "@studnicky/entity": "^15.2.1",
    "@studnicky/json-tology": "0.27.1",
    "@studnicky/types": "^15.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/iridis.git",
    "directory": "packages/algebra"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15"
  }
}
