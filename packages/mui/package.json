{
  "name": "@studnicky/iridis-mui",
  "description": "Emits an MUI theme (createTheme() palette config) from resolved roles.",
  "version": "0.11.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json",
    "prepare:publish": "node ../../scripts/package-pipeline.mjs mui",
    "build:package": "pnpm run build && pnpm run prepare:publish",
    "pack:dry": "pnpm run build:package && npm pack --dry-run ./.publish",
    "publish:dry": "pnpm run build:package && npm publish --dry-run ./.publish",
    "typecheck": "tsc --noEmit",
    "test": "TSX_TSCONFIG_PATH=../../tsconfig.json node --import tsx --test 'tests/**/*.test.ts'",
    "clean": "rm -rf .publish dist"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@studnicky/iridis": "workspace:*"
  },
  "dependencies": {
    "@studnicky/logger": "^4.0.0",
    "@studnicky/types": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/iridis.git",
    "directory": "packages/mui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
